# Database
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Basic Auth
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Run Port
PORT=8080

# Storage Config
STORAGE_PROVIDER=ORACLE

# Object Storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# JWT
JWT_SECRET=

# Token Expiry
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Kafka
KAFKA_BROKERS=localhost:9092

# ONNX Face Verification
FACE_VERIFICATION_PROVIDER=onnx
ONNX_MODEL_PATH=./models/arcface_resnet50.onnx
ONNXRUNTIME_SHARED_LIBRARY_PATH=./lib/libonnxruntime.so

# Environment
APP_ENV=development
BASE_URL=
APPLE_TEAM_ID=
ANDROID_SHA256_CERT=

# Notification
FIREBASE_SERVICE_ACCOUNT_PATH=

# GIF Provider
GIF_PROVIDER=klipy
KLIPY_API_KEY=
KLIPY_SHOW_ADS=false
